# Monetize360 Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./monetize360.db

# Gemini AI Copilot Integration (Server-side only)
# If left blank or unset, the system automatically falls back to the deterministic offline copilot
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Authentication & Realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Demo Account Credentials (Optional)
NEXT_PUBLIC_DEMO_EMAIL=demo@monetize360.com
NEXT_PUBLIC_DEMO_PASSWORD=your_demo_password_here

# Next.js Frontend & API Proxy Target
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

